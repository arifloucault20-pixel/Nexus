                    type="date"
                    value={invoiceForm.dueDate}
                    onChange={(e) => setInvoiceForm({ ...invoiceForm, dueDate: e.target.value })}
                    className={`w-full px-3 py-2 rounded-xl border outline-none ${theme.input}`}
                  />
                </div>
                <div>
                  <label className="block font-semibold mb-1">Status</label>
                  <select
                    value={invoiceForm.status}
                    onChange={(e) => setInvoiceForm({ ...invoiceForm, status: e.target.value })}
                    className={`w-full px-3 py-2 rounded-xl border outline-none ${theme.input}`}
                  >
                    <option value="Pending">Pending (Balance Due)</option>
                    <option value="Paid">Already Paid</option>
                  </select>
                </div>
              </div>

              <div
                className={`p-3.5 rounded-2xl border flex items-center justify-between text-sm font-bold ${theme.surface} ${theme.border}`}
              >
                <span>Total (CAD)</span>
                <span className="tabular-nums">{formatCurrency(invoiceTotal)}</span>
              </div>

              <div className="flex justify-end gap-2 pt-2">
                <button
                  type="button"
                  onClick={() => setShowInvoiceModal(false)}
                  className={`px-4 py-2 rounded-full font-semibold cursor-pointer ${theme.secondaryBtn}`}
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  className={`px-5 py-2 rounded-full font-semibold cursor-pointer ${theme.primaryBtn}`}
                >
                  Save Invoice
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* ================= MODAL: PRINTABLE RECEIPT PREVIEW ================= */}
      {viewingReceipt && activeClient && (
        <div className="fixed inset-0 z-50 bg-black/50 backdrop-blur-xs flex items-center justify-center p-4">
          <div className={`w-full max-w-md rounded-3xl border p-6 sm:p-7 shadow-2xl ${theme.card}`}>
            <div className="flex items-start justify-between pb-4 border-b border-current/10">
              <div>
                <span className="text-base font-extrabold tracking-tight">NEXUS RECEIPT</span>
                <p className={`text-xs mt-0.5 ${theme.mutedText}`}>
                  {viewingReceipt.id} · {viewingReceipt.date}
                </p>
              </div>
              <button
                type="button"
                onClick={() => setViewingReceipt(null)}
                className={`p-1.5 rounded-full cursor-pointer ${theme.hoverBg}`}
              >
                <Icon name="x" className="w-4 h-4" />
              </button>
            </div>

            <div className="py-4 text-xs space-y-1">
              <p className="font-bold">{activeClient.name}</p>
              <p className={theme.mutedText}>{activeClient.email}</p>
              <p className="pt-1 font-semibold">Status: {viewingReceipt.status}</p>
            </div>

            <div className={`rounded-2xl border overflow-hidden ${theme.border}`}>
              <table className="w-full text-xs text-left">
                <thead>
                  <tr className={`border-b ${theme.border} ${theme.surface} text-[10px] uppercase`}>
                    <th className="py-2 px-3.5">Description</th>
                    <th className="py-2 px-3.5 text-right">Amount</th>
                  </tr>
                </thead>
                <tbody className={`divide-y ${darkMode ? 'divide-[#27272A]' : 'divide-[#E4E4E7]'}`}>
                  {(
                    viewingReceipt.items || [
                      { desc: viewingReceipt.description, qty: 1, rate: viewingReceipt.amount }
                    ]
                  ).map((it, idx) => (
                    <tr key={idx}>
                      <td className="py-2.5 px-3.5 font-medium">
                        {it.desc} {it.qty > 1 ? `(x${it.qty})` : ''}
                      </td>
                      <td className="py-2.5 px-3.5 text-right font-semibold tabular-nums">
                        {formatCurrency(it.qty * it.rate)}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div className="mt-4 flex items-center justify-between font-bold text-base">
              <span>Total</span>
              <span className="tabular-nums">{formatCurrency(viewingReceipt.amount)}</span>
            </div>

            <div className="flex justify-end gap-2 mt-6 pt-4 border-t border-current/10">
              <button
                type="button"
                onClick={() => {
                  try {
                    window.print?.();
                  } catch {
                    // ignore print restrictions
                  }
                  showToast('Sent to print / PDF');
                }}
                className={`flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-semibold cursor-pointer ${theme.secondaryBtn}`}
              >
                <Icon name="printer" className="w-3.5 h-3.5" />
                <span>Print / PDF</span>
              </button>
              {viewingReceipt.status !== 'Paid' && (
                <button
                  type="button"
                  onClick={() => {
                    handleMarkPaid(viewingReceipt.id);
                    setViewingReceipt({ ...viewingReceipt, status: 'Paid' });
                  }}
                  className={`px-4 py-2 rounded-full text-xs font-semibold cursor-pointer ${theme.primaryBtn}`}
                >
                  Mark Paid
                </button>
              )}
            </div>
          </div>
        </div>
      )}

      {/* ================= MODAL: ADD SCHEDULE DATE ================= */}
      {showPlanModal && activeClient && (
        <div className="fixed inset-0 z-50 bg-black/50 backdrop-blur-xs flex items-center justify-center p-4">
          <div className={`w-full max-w-md rounded-3xl border p-6 shadow-2xl ${theme.card}`}>
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-base font-bold">Schedule Session</h3>
              <button
                type="button"
                onClick={() => setShowPlanModal(false)}
                className={`p-1.5 rounded-full cursor-pointer ${theme.hoverBg}`}
              >
                <Icon name="x" className="w-4 h-4" />
              </button>
            </div>
            <form onSubmit={handleAddPlan} className="space-y-3.5 text-xs">
              <div>
                <label className="block font-semibold mb-1">Session / Milestone Title *</label>
                <input
                  type="text"
                  required
                  value={planForm.title}
                  onChange={(e) => setPlanForm({ ...planForm, title: e.target.value })}
                  placeholder="e.g. Twilight Exterior Shoot"
                  className={`w-full px-3.5 py-2 rounded-xl border outline-none ${theme.input}`}
                />
              </div>
              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block font-semibold mb-1">Date *</label>
                  <input
                    type="date"
                    required
                    value={planForm.date}
                    onChange={(e) => setPlanForm({ ...planForm, date: e.target.value })}
                    className={`w-full px-3.5 py-2 rounded-xl border outline-none ${theme.input}`}
                  />
                </div>
                <div>
                  <label className="block font-semibold mb-1">Time</label>
                  <input
                    type="text"
                    value={planForm.time}
                    onChange={(e) => setPlanForm({ ...planForm, time: e.target.value })}
                    className={`w-full px-3.5 py-2 rounded-xl border outline-none ${theme.input}`}
                  />
                </div>
              </div>
              <div>
                <label className="block font-semibold mb-1">Location / Link</label>
                <input
                  type="text"
                  value={planForm.location}
                  onChange={(e) => setPlanForm({ ...planForm, location: e.target.value })}
                  placeholder="Address or Google Meet link"
                  className={`w-full px-3.5 py-2 rounded-xl border outline-none ${theme.input}`}
                />
              </div>
              <div className="flex justify-end gap-2 pt-3">
                <button
                  type="button"
                  onClick={() => setShowPlanModal(false)}
                  className={`px-4 py-2 rounded-full font-semibold cursor-pointer ${theme.secondaryBtn}`}
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  className={`px-5 py-2 rounded-full font-semibold cursor-pointer ${theme.primaryBtn}`}
                >
                  Save Date
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}
