                  className={`text-[11px] font-medium px-3 py-1 rounded-full border tabular-nums flex items-center gap-2 ${
                    darkMode ? 'bg-[#18181B] border-[#27272A] text-[#FAFAFA]' : 'bg-[#FAFAFA] border-[#E4E4E7] text-[#09090B]'
                  }`}
                >
                  <span className="font-bold">{activePoint.month}</span>
                  <span><strong>{formatCurrency(activePoint.collected)}</strong> paid</span>
                  {activePoint.pending > 0 && (
                    <span className="text-amber-500">+{formatCurrency(activePoint.pending)} due</span>
                  )}
                  {selectedIdx !== null && (
                    <button
                      type="button"
                      onClick={() => setSelectedIdx(null)}
                      className="opacity-60 hover:opacity-100 ml-0.5 cursor-pointer"
                    >
                      ×
                    </button>
                  )}
                </div>
              )}

              <div
                className={`inline-flex items-center p-0.5 rounded-full border text-[11px] font-semibold ${
                  darkMode ? 'bg-[#09090B] border-[#27272A]' : 'bg-[#F4F4F5] border-[#E4E4E7]'
                }`}
              >
                {[
                  { id: 'bar', label: 'Bars' },
                  { id: 'trend', label: 'Trend' },
                  { id: 'split', label: 'Split' }
                ].map((mode) => {
                  const active = chartType === mode.id;
                  return (
                    <button
                      key={mode.id}
                      type="button"
                      onClick={() => {
                        setChartType(mode.id);
                        setHoveredIdx(null);
                      }}
                      className={`px-3 py-1 rounded-full transition-all cursor-pointer ${
                        active
                          ? darkMode
                            ? 'bg-[#FAFAFA] text-[#09090B]'
                            : 'bg-[#09090B] text-[#FFFFFF]'
                          : darkMode
                          ? 'text-[#A1A1AA] hover:text-[#FAFAFA]'
                          : 'text-[#71717A] hover:text-[#09090B]'
                      }`}
                    >
                      {mode.label}
                    </button>
                  );
                })}
              </div>
            </div>
          </div>

          {chartType === 'bar' && (
            <div className="w-full h-48 select-none">
              <svg viewBox="0 0 600 180" className="w-full h-full overflow-visible">
                {[0, 0.25, 0.5, 0.75, 1].map((ratio, idx) => {
                  const y = 142 - ratio * 118;
                  const labelVal = Math.round(maxVal * ratio);
                  return (
                    <g key={idx}>
                      <line
                        x1="48"
                        y1={y}
                        x2="590"
                        y2={y}
                        stroke={darkMode ? '#27272A' : '#E4E4E7'}
                        strokeDasharray={ratio === 0 ? '0' : '3 3'}
                        strokeWidth="1"
                      />
                      {idx % 2 === 0 && (
                        <text x="40" y={y + 4} textAnchor="end" fill={darkMode ? '#71717A' : '#A1A1AA'} fontSize="10" fontFamily="monospace">
                          ${labelVal >= 1000 ? `${(labelVal / 1000).toFixed(1)}k` : labelVal}
                        </text>
                      )}
                    </g>
                  );
                })}

                {data.map((d, i) => {
                  const slotWidth = 530 / data.length;
                  const barWidth = Math.min(40, slotWidth * 0.52);
                  const x = 62 + i * slotWidth + (slotWidth - barWidth) / 2;
                  const collectedHeight = (d.collected / maxVal) * 118;
                  const pendingHeight = (d.pending / maxVal) * 118;
                  const yCollected = 142 - collectedHeight;
                  const yPending = yCollected - pendingHeight;
                  const isHighlighted = activeIdx === i;

                  return (
                    <g
                      key={d.month}
                      className="cursor-pointer"
                      onMouseEnter={() => setHoveredIdx(i)}
                      onMouseLeave={() => setHoveredIdx(null)}
                      onClick={() => setSelectedIdx((prev) => (prev === i ? null : i))}
                    >
                      <rect
                        x={x - 8}
                        y={14}
                        width={barWidth + 16}
                        height={128}
                        rx="10"
                        fill={isHighlighted ? (darkMode ? '#18181B' : '#F4F4F5') : 'transparent'}
                      />
                      {pendingHeight > 0 && (
                        <rect x={x} y={yPending} width={barWidth} height={Math.max(pendingHeight, 3)} rx="5" fill="#F59E0B" />
                      )}
                      {collectedHeight > 0 && (
                        <rect
                          x={x}
                          y={yCollected}
                          width={barWidth}
                          height={Math.max(collectedHeight, 3)}
                          rx="5"
                          fill={darkMode ? '#FAFAFA' : '#09090B'}
                        />
                      )}
                      {isHighlighted && d.collected + d.pending > 0 && (
                        <text
                          x={x + barWidth / 2}
                          y={Math.max(12, (pendingHeight > 0 ? yPending : yCollected) - 6)}
                          textAnchor="middle"
                          fill={darkMode ? '#FAFAFA' : '#09090B'}
                          fontSize="10"
                          fontWeight="700"
                          fontFamily="monospace"
                        >
                          ${Math.round(d.collected + d.pending).toLocaleString()}
                        </text>
                      )}
                      <text
                        x={x + barWidth / 2}
                        y="163"
                        textAnchor="middle"
                        fill={isHighlighted ? (darkMode ? '#FAFAFA' : '#09090B') : (darkMode ? '#A1A1AA' : '#71717A')}
                        fontSize="11"
                        fontWeight={isHighlighted ? '700' : '500'}
                      >
                        {d.month}
                      </text>
                    </g>
                  );
                })}
              </svg>
            </div>
          )}

          {chartType === 'trend' && (
            <div className="w-full h-48 select-none">
              <svg viewBox="0 0 600 180" className="w-full h-full overflow-visible">
                {[0, 0.5, 1].map((ratio, idx) => {
                  const y = 142 - ratio * 118;
                  const labelVal = Math.round(maxVal * ratio);
                  return (
                    <g key={idx}>
                      <line
                        x1="48"
                        y1={y}
                        x2="590"
                        y2={y}
                        stroke={darkMode ? '#27272A' : '#E4E4E7'}
                        strokeDasharray={ratio === 0 ? '0' : '3 3'}
                        strokeWidth="1"
                      />
                      <text x="40" y={y + 4} textAnchor="end" fill={darkMode ? '#71717A' : '#A1A1AA'} fontSize="10" fontFamily="monospace">
                        ${labelVal >= 1000 ? `${(labelVal / 1000).toFixed(1)}k` : labelVal}
                      </text>
                    </g>
                  );
                })}

                {trendGeometry.areaPath && (
                  <path d={trendGeometry.areaPath} fill={darkMode ? 'rgba(250,250,250,0.08)' : 'rgba(9,9,11,0.07)'} />
                )}
                {trendGeometry.totalLine && (
                  <path d={trendGeometry.totalLine} fill="none" stroke="#F59E0B" strokeWidth="2" strokeDasharray="5 4" strokeLinecap="round" />
                )}
                {trendGeometry.collectedLine && (
                  <path d={trendGeometry.collectedLine} fill="none" stroke={darkMode ? '#FAFAFA' : '#09090B'} strokeWidth="2.75" strokeLinecap="round" />
                )}

                {trendGeometry.points.map((pt, i) => {
                  const isHighlighted = activeIdx === i;
                  return (
                    <g
                      key={pt.month}
                      className="cursor-pointer"
                      onMouseEnter={() => setHoveredIdx(i)}
                      onMouseLeave={() => setHoveredIdx(null)}
                      onClick={() => setSelectedIdx((prev) => (prev === i ? null : i))}
                    >
                      <rect x={pt.x - 28} y={14} width={56} height={132} fill="transparent" />
                      {pt.pending > 0 && <circle cx={pt.x} cy={pt.yTotal} r={isHighlighted ? 5.5 : 3.5} fill="#F59E0B" />}
                      <circle
                        cx={pt.x}
                        cy={pt.yCollected}
                        r={isHighlighted ? 6 : 4}
                        fill={darkMode ? '#FAFAFA' : '#09090B'}
                        stroke={darkMode ? '#111114' : '#FFFFFF'}
                        strokeWidth="2"
                      />
                      <text
                        x={pt.x}
                        y="163"
                        textAnchor="middle"
                        fill={isHighlighted ? (darkMode ? '#FAFAFA' : '#09090B') : (darkMode ? '#A1A1AA' : '#71717A')}
                        fontSize="11"
                        fontWeight={isHighlighted ? '700' : '500'}
                      >
                        {pt.month}
                      </text>
                    </g>
                  );
                })}
              </svg>
            </div>
          )}

          {chartType === 'split' && (
            <div className="min-h-48 grid grid-cols-1 sm:grid-cols-12 gap-4 items-center pt-1">
              <div className="sm:col-span-5 flex items-center justify-center relative">
                <svg viewBox="0 0 140 140" className="w-36 h-36 -rotate-90">
                  <circle cx="70" cy="70" r="52" fill="none" stroke={totals.pending > 0 ? '#F59E0B' : (darkMode ? '#27272A' : '#E4E4E7')} strokeWidth="14" />
                  {totals.collected > 0 && (
                    <circle
                      cx="70"
                      cy="70"
                      r="52"
                      fill="none"
                      stroke={darkMode ? '#FAFAFA' : '#09090B'}
                      strokeWidth="14"
                      strokeDasharray={`${collectedArc} ${donutCircumference}`}
                      strokeLinecap="round"
                    />
                  )}
                </svg>
                <div className="absolute inset-0 flex flex-col items-center justify-center text-center pointer-events-none">
                  <span className="text-lg font-extrabold tabular-nums">{totals.paidPct}%</span>
                  <span className={`text-[10px] font-medium ${darkMode ? 'text-[#A1A1AA]' : 'text-[#71717A]'}`}>Collected</span>
                </div>
              </div>

              <div className="sm:col-span-7 space-y-2">
                <div className="grid grid-cols-2 gap-2 pb-1 text-xs">
                  <div className={`p-2.5 rounded-2xl border ${darkMode ? 'bg-[#18181B] border-[#27272A]' : 'bg-[#FAFAFA] border-[#E4E4E7]'}`}>
                    <span className={`text-[10px] block ${darkMode ? 'text-[#A1A1AA]' : 'text-[#71717A]'}`}>6-Mo Collected</span>
                    <span className="font-bold tabular-nums">{formatCurrency(totals.collected)}</span>
                  </div>
                  <div className={`p-2.5 rounded-2xl border ${darkMode ? 'bg-[#18181B] border-[#27272A]' : 'bg-[#FAFAFA] border-[#E4E4E7]'}`}>
                    <span className={`text-[10px] block ${darkMode ? 'text-[#A1A1AA]' : 'text-[#71717A]'}`}>6-Mo Pending</span>
                    <span className="font-bold tabular-nums text-amber-500">{formatCurrency(totals.pending)}</span>
                  </div>
                </div>

                <div className="space-y-1.5">
                  {data.map((d) => {
                    const rowTotal = (d.collected || 0) + (d.pending || 0);
                    const widthPct = maxVal > 0 ? Math.min(100, (rowTotal / maxVal) * 100) : 0;
                    const paidSharePct = rowTotal > 0 ? ((d.collected || 0) / rowTotal) * 100 : 0;
                    return (
                      <div key={d.month} className="flex items-center gap-2.5 text-[11px]">
                        <span className="w-7 font-semibold opacity-75">{d.month}</span>
                        <div className={`flex-1 h-2 rounded-full overflow-hidden ${darkMode ? 'bg-[#18181B]' : 'bg-[#F4F4F5]'}`}>
                          <div className="h-full flex rounded-full overflow-hidden" style={{ width: `${Math.max(widthPct, rowTotal > 0 ? 4 : 0)}%` }}>
                            <div style={{ width: `${paidSharePct}%` }} className={darkMode ? 'bg-[#FAFAFA]' : 'bg-[#09090B]'} />
                            <div style={{ width: `${100 - paidSharePct}%` }} className="bg-amber-400" />
                          </div>
                        </div>
                        <span className="w-20 text-right font-semibold tabular-nums">{formatCurrency(rowTotal)}</span>
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>
          )}
        </div>
      );
    }

    // Dedicated Full-Page Schedule Workspace
    function ScheduleWorkspace({
      clients,
      scopedClient,
      darkMode,
      theme,
      onTogglePlanCompleted,
      onDeletePlan,
      onOpenNewPlanModal,
      onSelectClient
    }) {
      const [scheduleLayout, setScheduleLayout] = useState('calendar');
      const [statusFilter, setStatusFilter] = useState('all');
      const [selectedDateFilter, setSelectedDateFilter] = useState(null);
      const [calendarMonth, setCalendarMonth] = useState(() => new Date(2026, 10, 1));

      const allEvents = useMemo(() => {
        const sourceClients = scopedClient ? [scopedClient] : clients;
        const list = [];
        sourceClients.forEach((client) => {
          (client.plans || []).forEach((plan) => {
            list.push({
              ...plan,
              clientId: client.id,
              clientName: client.name,
              clientService: client.service
            });
          });
        });
        return list.sort((a, b) => (a.date || '').localeCompare(b.date || ''));
      }, [clients, scopedClient]);

      const stats = useMemo(() => {
        const total = allEvents.length;
        const completed = allEvents.filter((e) => e.completed).length;
        const upcoming = total - completed;
        return { total, completed, upcoming };
      }, [allEvents]);

      const filteredEvents = useMemo(() => {
        return allEvents.filter((ev) => {
          if (statusFilter === 'upcoming' && ev.completed) return false;
          if (statusFilter === 'completed' && !ev.completed) return false;
          if (selectedDateFilter && ev.date !== selectedDateFilter) return false;
          return true;
        });
      }, [allEvents, statusFilter, selectedDateFilter]);

      const calendarGrid = useMemo(() => {
        const year = calendarMonth.getFullYear();
        const month = calendarMonth.getMonth();
        const firstWeekday = new Date(year, month, 1).getDay();
        const daysInMonth = new Date(year, month + 1, 0).getDate();

        const cells = [];
        for (let i = 0; i < firstWeekday; i++) cells.push(null);
        for (let day = 1; day <= daysInMonth; day++) {
          const yyyy = String(year);
          const mm = String(month + 1).padStart(2, '0');
          const dd = String(day).padStart(2, '0');
          const iso = `${yyyy}-${mm}-${dd}`;
          const dayEvents = allEvents.filter((e) => e.date === iso);
          cells.push({ day, iso, events: dayEvents });
        }
        return cells;
      }, [calendarMonth, allEvents]);

      const monthLabel = calendarMonth.toLocaleDateString('en-US', {
        month: 'long',
        year: 'numeric'
      });

      return (
        <div className="space-y-6">
          <div className={`p-6 rounded-3xl border ${theme.card}`}>
            <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <div className="flex items-center gap-2">
                  <span className={`text-[10px] font-bold uppercase tracking-widest px-2.5 py-0.5 rounded-full border ${theme.border}`}>
                    {scopedClient ? scopedClient.name : 'Master Agency Calendar'}
                  </span>
                  <span className={`text-xs ${theme.mutedText}`}>
                    {stats.upcoming} upcoming · {stats.completed} completed
                  </span>
                </div>
                <h1 className="text-2xl font-bold tracking-tight mt-2">
                  {scopedClient ? `${scopedClient.name} — Production & Session Schedule` : 'Master Schedule & Production Board'}
                </h1>
                <p className={`text-xs mt-1 ${theme.mutedText}`}>
                  Full-page timeline for shoots, strategy calls, deliverables, and on-site milestones.
                </p>
              </div>

              <div className="flex flex-wrap items-center gap-2">
                <div className={`inline-flex items-center p-0.5 rounded-full border text-xs font-semibold ${darkMode ? 'bg-[#09090B] border-[#27272A]' : 'bg-[#F4F4F5] border-[#E4E4E7]'}`}>
                  <button
                    type="button"
                    onClick={() => setScheduleLayout('calendar')}
                    className={`px-3.5 py-1.5 rounded-full transition-all cursor-pointer ${
                      scheduleLayout === 'calendar'
                        ? darkMode
                          ? 'bg-[#FAFAFA] text-[#09090B]'
                          : 'bg-[#09090B] text-[#FFFFFF]'
                        : theme.mutedText
                    }`}
                  >
                    Month Grid
                  </button>
                  <button
                    type="button"
                    onClick={() => setScheduleLayout('agenda')}
                    className={`px-3.5 py-1.5 rounded-full transition-all cursor-pointer ${
                      scheduleLayout === 'agenda'
                        ? darkMode
                          ? 'bg-[#FAFAFA] text-[#09090B]'
                          : 'bg-[#09090B] text-[#FFFFFF]'
                        : theme.mutedText
                    }`}
                  >
                    Agenda List
                  </button>
                </div>

                <button
                  type="button"
                  onClick={onOpenNewPlanModal}
                  className={`flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-semibold cursor-pointer ${theme.primaryBtn}`}
                >
                  <Icon name="plus" className="w-3.5 h-3.5" />
                  <span>Book Session</span>
                </button>
              </div>
            </div>

            <div className={`flex flex-wrap items-center justify-between gap-3 mt-5 pt-4 border-t ${theme.border}`}>
              <div className="flex items-center gap-1.5">
                {[
                  { id: 'all', label: `All Sessions (${stats.total})` },
                  { id: 'upcoming', label: `Upcoming (${stats.upcoming})` },
                  { id: 'completed', label: `Completed (${stats.completed})` }
                ].map((pill) => (
                  <button
                    key={pill.id}
                    type="button"
                    onClick={() => setStatusFilter(pill.id)}
                    className={`px-3 py-1.5 rounded-full text-xs font-semibold transition-colors cursor-pointer ${
                      statusFilter === pill.id
                        ? darkMode
                          ? 'bg-[#FAFAFA] text-[#09090B]'
                          : 'bg-[#09090B] text-[#FFFFFF]'
                        : `${theme.mutedText} ${theme.hoverBg}`
                    }`}
                  >
                    {pill.label}
                  </button>
                ))}
              </div>

              {selectedDateFilter && (
                <button
                  type="button"
                  onClick={() => setSelectedDateFilter(null)}
                  className={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold border cursor-pointer ${theme.border} ${theme.hoverBg}`}
                >
                  <span>Filtered: {selectedDateFilter}</span>
                  <Icon name="x" className="w-3 h-3" />
                </button>
              )}
            </div>
          </div>

          {scheduleLayout === 'calendar' && (
            <div className={`p-5 rounded-3xl border space-y-4 ${theme.card}`}>
              <div className="flex items-center justify-between">
                <h2 className="text-sm font-bold tracking-tight">{monthLabel}</h2>
                <div className="flex items-center gap-1.5">
                  <button
                    type="button"
                    onClick={() => setCalendarMonth((prev) => new Date(prev.getFullYear(), prev.getMonth() - 1, 1))}
                    className={`px-3 py-1 rounded-full text-xs font-semibold cursor-pointer ${theme.secondaryBtn}`}
                  >
                    ← Prev
                  </button>
                  <button
                    type="button"
                    onClick={() => setCalendarMonth(new Date(2026, 10, 1))}
                    className={`px-3 py-1 rounded-full text-xs font-semibold cursor-pointer ${theme.secondaryBtn}`}
                  >
                    Nov 2026
                  </button>
                  <button
                    type="button"
                    onClick={() => setCalendarMonth((prev) => new Date(prev.getFullYear(), prev.getMonth() + 1, 1))}
                    className={`px-3 py-1 rounded-full text-xs font-semibold cursor-pointer ${theme.secondaryBtn}`}
                  >
                    Next →
                  </button>
                </div>
              </div>

              <div className="grid grid-cols-7 gap-1.5 text-center text-[10px] font-bold uppercase tracking-wider opacity-60">
                {['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map((d) => (
                  <div key={d} className="py-1">{d}</div>
                ))}
              </div>

              <div className="grid grid-cols-7 gap-1.5">
                {calendarGrid.map((cell, idx) => {
                  if (!cell) return <div key={`empty-${idx}`} className="min-h-24 rounded-2xl opacity-25" />;
                  const isSelected = selectedDateFilter === cell.iso;
                  const hasEvents = cell.events.length > 0;
                  return (
                    <button
                      key={cell.iso}
                      type="button"
                      onClick={() => setSelectedDateFilter((prev) => (prev === cell.iso ? null : cell.iso))}
                      className={`min-h-24 p-2 rounded-2xl border text-left flex flex-col justify-between transition-all cursor-pointer ${
                        isSelected
                          ? darkMode
                            ? 'bg-[#18181B] border-[#FAFAFA]'
                            : 'bg-[#FAFAFA] border-[#09090B]'
                          : hasEvents
                          ? `${theme.surface} ${theme.border} ${theme.hoverBg}`
                          : `border-transparent ${theme.hoverBg}`
                      }`}
                    >
                      <div className="flex items-center justify-between w-full">
                        <span className="text-xs font-bold tabular-nums">{cell.day}</span>
                        {hasEvents && <span className={`w-2 h-2 rounded-full ${darkMode ? 'bg-[#FAFAFA]' : 'bg-[#09090B]'}`} />}
                      </div>

                      <div className="w-full space-y-1 mt-1">
                        {cell.events.slice(0, 2).map((ev) => (
                          <div
                            key={ev.id}
                            className={`px-1.5 py-0.5 rounded-md text-[10px] font-semibold truncate ${
                              ev.completed
                                ? 'line-through opacity-50 bg-zinc-500/15'
                                : darkMode
                                ? 'bg-[#FAFAFA] text-[#09090B]'
                                : 'bg-[#09090B] text-[#FFFFFF]'
                            }`}
                          >
                            {ev.time} · {ev.title}
                          </div>
                        ))}
                      </div>
                    </button>
                  );
                })}
              </div>
            </div>
          )}

          <div className={`rounded-3xl border p-5 space-y-3 ${theme.card}`}>
            <div className="flex items-center justify-between pb-1">
              <h2 className="text-xs font-bold uppercase tracking-wider">
                {selectedDateFilter ? `Sessions on ${selectedDateFilter}` : 'Detailed Session Timeline'}
              </h2>
              <span className={`text-[11px] ${theme.mutedText}`}>
                {filteredEvents.length} {filteredEvents.length === 1 ? 'item' : 'items'}
              </span>
            </div>

            {filteredEvents.length === 0 ? (
              <div className={`py-12 text-center text-xs ${theme.mutedText}`}>
                No sessions match this filter. Click <strong>+ Book Session</strong> to schedule one.
              </div>
            ) : (
              filteredEvents.map((plan) => (
                <div
                  key={plan.id}
                  className={`p-4 rounded-2xl border transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-4 ${
                    plan.completed ? 'opacity-60 border-dashed' : `${theme.border} ${theme.hoverBg}`
                  }`}
                >
                  <div className="flex items-start gap-3.5">
                    <button
                      type="button"
                      onClick={() => onTogglePlanCompleted(plan.clientId, plan.id)}
                      className={`mt-0.5 w-5 h-5 rounded-lg border flex items-center justify-center shrink-0 transition-colors cursor-pointer ${
                        plan.completed
                          ? darkMode
                            ? 'bg-[#FAFAFA] border-[#FAFAFA] text-[#09090B]'
                            : 'bg-[#09090B] border-[#09090B] text-[#FFFFFF]'
                          : theme.border
                      }`}
                    >
                      {plan.completed && <Icon name="check" className="w-3.5 h-3.5 stroke-[2.5]" />}
                    </button>

                    <div>
                      <div className="flex flex-wrap items-center gap-2">
                        <h3 className={`text-sm font-bold ${plan.completed ? 'line-through' : ''}`}>{plan.title}</h3>
                        {!scopedClient && (
                          <button
                            type="button"
                            onClick={() => onSelectClient(plan.clientId)}
                            className={`text-[10px] font-bold px-2.5 py-0.5 rounded-full border cursor-pointer ${theme.border} ${theme.hoverBg}`}
                          >
                            {plan.clientName}
                          </button>
                        )}
                      </div>

                      <div className={`flex flex-wrap items-center gap-3 text-xs mt-1.5 ${theme.mutedText}`}>
                        <span className="flex items-center gap-1 font-semibold text-current">
                          <Icon name="calendar" className="w-3.5 h-3.5" />
                          {plan.date}
                        </span>
                        <span className="flex items-center gap-1 font-medium text-current">
                          <Icon name="clock" className="w-3.5 h-3.5" />
                          {plan.time}
                        </span>
                        <span className="flex items-center gap-1">
                          <Icon name="mapPin" className="w-3.5 h-3.5" />
                          {plan.location}
                        </span>
                      </div>
                    </div>
                  </div>

                  <div className="flex items-center gap-2 self-end sm:self-center">
                    <span
                      className={`text-[11px] font-semibold px-2.5 py-1 rounded-full border ${
                        plan.completed
                          ? theme.border
                          : darkMode
                          ? 'border-emerald-500/30 text-emerald-400 bg-emerald-500/10'
                          : 'border-emerald-200 text-emerald-700 bg-emerald-50'
                      }`}
                    >
                      {plan.completed ? 'Completed' : 'Confirmed'}
                    </span>
                    <button
                      type="button"
                      onClick={() => onDeletePlan(plan.clientId, plan.id)}
                      className={`p-1.5 rounded-full border cursor-pointer ${theme.border} ${theme.hoverBg} hover:text-rose-500`}
                    >
                      <Icon name="trash" className="w-3.5 h-3.5" />
                    </button>
                  </div>
                </div>
              ))
            )}
          </div>
        </div>
      );
    }

