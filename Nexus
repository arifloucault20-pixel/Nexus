const normalizeClientRow = (row) => ({
  id: row.id,
  name: row.name || 'Unnamed Client',
  company: row.company || row.name || 'Client',
  service: row.service || 'Client Service',
  email: row.email || '',
  phone: row.phone || '',
  status: row.status || 'Active',
  monthlyHistory:
    Array.isArray(row.monthly_history) && row.monthly_history.length > 0
      ? row.monthly_history
      : Array.isArray(row.monthlyHistory) && row.monthlyHistory.length > 0
      ? row.monthlyHistory
      : DEFAULT_MONTHS,
  transactions: Array.isArray(row.transactions) ? row.transactions : [],
  plans: Array.isArray(row.plans) ? row.plans : []
});

const serializeClientRow = (client) => ({
  id: client.id,
  name: client.name,
  company: client.company,
  service: client.service,
  email: client.email,
  phone: client.phone,
  status: client.status,
  monthly_history: client.monthlyHistory,
  transactions: client.transactions,
  plans: client.plans,
  updated_at: new Date().toISOString()
});

const formatCurrency = (amount) =>
  new Intl.NumberFormat('en-CA', {
    style: 'currency',
    currency: 'CAD',
    minimumFractionDigits: 2
  }).format(amount || 0);

const getInitials = (name) =>
  (name || 'NX')
    .split(' ')
    .filter(Boolean)
    .map((n) => n[0])
    .join('')
    .toUpperCase()
    .slice(0, 2);

// Clean 6-Month Collected vs Pending Revenue Bar Chart with Hover Tooltips
function RevenueChart({ data, darkMode }) {
  const [hoveredIdx, setHoveredIdx] = useState(null);

  const maxVal = useMemo(() => {
    const peak = Math.max(...data.map((d) => d.collected + d.pending), 1000);
    return Math.ceil(peak / 500) * 500;
  }, [data]);

  return (
    <div className="relative pt-2">
      <div className="flex items-center justify-between mb-4">
        <div className="flex items-center gap-4 text-[11px]">
          <span className="flex items-center gap-1.5 font-semibold">
            <span
              className={`w-2.5 h-2.5 rounded-xs ${
                darkMode ? 'bg-[#FAFAFA]' : 'bg-[#09090B]'
              }`}
            />
            Collected
          </span>
          <span className="flex items-center gap-1.5 font-medium opacity-75">
            <span className="w-2.5 h-2.5 rounded-xs bg-amber-400" />
            Pending
          </span>
        </div>

        {hoveredIdx !== null && data[hoveredIdx] && (
          <div
            className={`text-[11px] font-medium px-3 py-1 rounded-full border tabular-nums ${
              darkMode
                ? 'bg-[#18181B] border-[#27272A] text-[#FAFAFA]'
                : 'bg-[#FAFAFA] border-[#E4E4E7] text-[#09090B]'
            }`}
          >
            {data[hoveredIdx].month}:{' '}
            <strong>{formatCurrency(data[hoveredIdx].collected)}</strong> paid
            {data[hoveredIdx].pending > 0 && (
              <span className="text-amber-500 ml-1.5">
                +{formatCurrency(data[hoveredIdx].pending)} due
              </span>
            )}
          </div>
        )}
      </div>

      <div className="w-full h-44 select-none">
        <svg viewBox="0 0 600 175" className="w-full h-full overflow-visible">
          {[0, 0.5, 1].map((ratio, idx) => {
            const y = 140 - ratio * 120;
            const labelVal = Math.round(maxVal * ratio);
            return (
              <g key={idx}>
                <line
                  x1="48"
                  y1={y}
                  x2="590"
                  y2={y}
                  stroke={darkMode ? '#27272A' : '#E4E4E7'}
                  strokeDasharray={ratio === 0 ? '0' : '4 4'}
                  strokeWidth="1"
                />
                <text
                  x="40"
                  y={y + 4}
                  textAnchor="end"
                  fill={darkMode ? '#71717A' : '#A1A1AA'}
                  fontSize="10"
                  fontFamily="monospace"
                >
                  ${labelVal >= 1000 ? `${(labelVal / 1000).toFixed(1)}k` : labelVal}
                </text>
              </g>
            );
          })}

          {data.map((d, i) => {
            const slotWidth = 530 / data.length;
            const barWidth = Math.min(38, slotWidth * 0.52);
            const x = 62 + i * slotWidth + (slotWidth - barWidth) / 2;

            const collectedHeight = (d.collected / maxVal) * 120;
            const pendingHeight = (d.pending / maxVal) * 120;

            const yCollected = 140 - collectedHeight;
            const yPending = yCollected - pendingHeight;
            const isHovered = hoveredIdx === i;

            return (
              <g
                key={d.month}
                className="cursor-pointer"
                onMouseEnter={() => setHoveredIdx(i)}
                onMouseLeave={() => setHoveredIdx(null)}
              >
                {isHovered && (
                  <rect
                    x={x - 6}
                    y={14}
                    width={barWidth + 12}
                    height={126}
                    rx="8"
                    fill={darkMode ? '#18181B' : '#F4F4F5'}
                  />
                )}
                {pendingHeight > 0 && (
                  <rect
                    x={x}
                    y={yPending}
                    width={barWidth}
                    height={Math.max(pendingHeight, 3)}
                    rx="4"
                    fill="#F59E0B"
                  />
                )}
                {collectedHeight > 0 && (
                  <rect
                    x={x}
                    y={yCollected}
                    width={barWidth}
                    height={Math.max(collectedHeight, 3)}
                    rx="4"
                    fill={darkMode ? '#FAFAFA' : '#09090B'}
                  />
                )}
                <text
                  x={x + barWidth / 2}
                  y="160"
                  textAnchor="middle"
                  fill={
                    isHovered
                      ? darkMode
                        ? '#FAFAFA'
                        : '#09090B'
                      : darkMode
                      ? '#A1A1AA'
                      : '#71717A'
                  }
                  fontSize="11"
                  fontWeight={isHovered ? '700' : '500'}
                >
                  {d.month}
                </text>
              </g>
            );
          })}
        </svg>
      </div>
    </div>
  );
}

export default function App() {
