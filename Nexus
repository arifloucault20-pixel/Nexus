      });

      const [showAddClientModal, setShowAddClientModal] = useState(false);
      const [newClientForm, setNewClientForm] = useState({ name: '', email: '', phone: '', service: '', quote: '1200' });

      const [showInvoiceModal, setShowInvoiceModal] = useState(false);
      const [invoiceForm, setInvoiceForm] = useState({
        description: '',
        dueDate: new Date(Date.now() + 7 * 86400000).toISOString().split('T')[0],
        status: 'Pending',
        items: [{ desc: 'Agency Service Package', qty: 1, rate: 1200 }]
      });
      const [viewingReceipt, setViewingReceipt] = useState(null);

      const [showPlanModal, setShowPlanModal] = useState(false);
      const [planForm, setPlanForm] = useState({
        clientId: INITIAL_CLIENTS[0].id,
        title: '',
        date: new Date().toISOString().split('T')[0],
        time: '10:00 AM',
        location: ''
      });

      const [showDigitalPayModal, setShowDigitalPayModal] = useState(false);
      const [digitalTxForm, setDigitalTxForm] = useState({
        amount: '500',
        method: 'Card / Stripe',
        reference: '',
        note: ''
      });
      const [processingDigitalTx, setProcessingDigitalTx] = useState(false);

      const [smsInput, setSmsInput] = useState('');
      const smsScrollRef = useRef(null);

      const [aiHistories, setAiHistories] = useState({});
      const [aiInput, setAiInput] = useState('');
      const [aiLoading, setAiLoading] = useState(false);
      const [aiMobileOpen, setAiMobileOpen] = useState(false);
      const [aiApiKey, setAiApiKey] = useState(() => {
        try {
          return window.localStorage?.getItem('nexus_gemini_key') || '';
        } catch {
          return '';
        }
      });
      const [showAiSettings, setShowAiSettings] = useState(false);
      const aiScrollRef = useRef(null);

      const [toast, setToast] = useState(null);
      const showToast = (msg) => {
        setToast(msg);
        setTimeout(() => setToast(null), 3000);
      };

      const isSupabaseConfigured = Boolean(supabaseConfig.url.trim() && supabaseConfig.anonKey.trim());

      useEffect(() => {
        try {
          window.localStorage?.setItem('nexus_clients_v1', JSON.stringify(clients));
        } catch {}
      }, [clients]);

      useEffect(() => {
        try {
          window.localStorage?.setItem('nexus_supabase_config', JSON.stringify(supabaseConfig));
        } catch {}
      }, [supabaseConfig]);

      // Supabase initial load
      useEffect(() => {
        if (!isSupabaseConfigured) {
          setSupabaseStatus('local');
          hasHydratedSupabaseRef.current = false;
          return;
        }
        let cancelled = false;
        const baseUrl = supabaseConfig.url.trim().replace(/\/+$/, '');
        const key = supabaseConfig.anonKey.trim();

        async function loadFromSupabase() {
          setSupabaseStatus('syncing');
          try {
            const res = await fetch(`${baseUrl}/rest/v1/clients?select=*&order=updated_at.desc`, {
              headers: { apikey: key, Authorization: `Bearer ${key}`, 'Content-Type': 'application/json' }
            });
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            const rows = await res.json();
            if (cancelled) return;

            if (Array.isArray(rows) && rows.length > 0) {
              const normalized = rows.map(normalizeClientRow);
              setClients(normalized);
              setSelectedClientId(normalized[0].id);
            } else {
              await fetch(`${baseUrl}/rest/v1/clients?on_conflict=id`, {
                method: 'POST',
                headers: {
                  apikey: key,
                  Authorization: `Bearer ${key}`,
                  'Content-Type': 'application/json',
                  Prefer: 'resolution=merge-duplicates,return=minimal'
                },
                body: JSON.stringify(INITIAL_CLIENTS.map(serializeClientRow))
              });
            }
            hasHydratedSupabaseRef.current = true;
            setSupabaseStatus('connected');
          } catch {
            if (!cancelled) {
              hasHydratedSupabaseRef.current = true;
              setSupabaseStatus('error');
            }
          }
        }
        loadFromSupabase();
        return () => { cancelled = true; };
      }, [isSupabaseConfigured, supabaseConfig.url, supabaseConfig.anonKey]);

      // Supabase background sync
      useEffect(() => {
        if (!isSupabaseConfigured || !hasHydratedSupabaseRef.current) return;
        const baseUrl = supabaseConfig.url.trim().replace(/\/+$/, '');
        const key = supabaseConfig.anonKey.trim();

        const timer = setTimeout(async () => {
          setSupabaseStatus('syncing');
          try {
            if (clients.length > 0) {
              const upsertRes = await fetch(`${baseUrl}/rest/v1/clients?on_conflict=id`, {
                method: 'POST',
                headers: {
                  apikey: key,
                  Authorization: `Bearer ${key}`,
                  'Content-Type': 'application/json',
                  Prefer: 'resolution=merge-duplicates,return=minimal'
                },
                body: JSON.stringify(clients.map(serializeClientRow))
              });
              if (!upsertRes.ok) throw new Error('Upsert failed');
            }
            setSupabaseStatus('connected');
          } catch {
            setSupabaseStatus('error');
          }
        }, 350);

        return () => clearTimeout(timer);
      }, [clients, isSupabaseConfigured, supabaseConfig.url, supabaseConfig.anonKey]);

      useEffect(() => {
        setConfirmDeleteId(null);
        setSmsInput('');
      }, [selectedClientId, viewMode]);

      useEffect(() => {
        if (smsScrollRef.current) smsScrollRef.current.scrollTop = smsScrollRef.current.scrollHeight;
      }, [selectedClientId, clients]);

      useEffect(() => {
        if (aiScrollRef.current) aiScrollRef.current.scrollTop = aiScrollRef.current.scrollHeight;
      }, [aiHistories, selectedClientId, aiLoading]);

      const activeClient = useMemo(
        () => clients.find((c) => c.id === selectedClientId) || clients[0] || null,
        [clients, selectedClientId]
      );

      const filteredClients = useMemo(() => {
        const q = searchQuery.toLowerCase();
        return clients.filter(
          (c) =>
            c.name.toLowerCase().includes(q) ||
            c.company.toLowerCase().includes(q) ||
            c.service.toLowerCase().includes(q)
        );
      }, [clients, searchQuery]);

      const clientFinancials = useMemo(() => {
        if (!activeClient) return { paid: 0, due: 0, nextSession: 'None scheduled' };
        const paid = activeClient.transactions.filter((t) => t.status === 'Paid').reduce((s, t) => s + t.amount, 0);
        const due = activeClient.transactions.filter((t) => t.status !== 'Paid').reduce((s, t) => s + t.amount, 0);
        const upcoming = activeClient.plans.find((p) => !p.completed);
        return {
          paid,
          due,
          nextSession: upcoming ? `${upcoming.date} · ${upcoming.time}` : 'None scheduled'
        };
      }, [activeClient]);

      const globalFinancials = useMemo(() => {
        let paid = 0;
        let due = 0;
        const months = ['Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov'];
        const mergedHistory = months.map((m) => ({ month: m, collected: 0, pending: 0 }));

        clients.forEach((c) => {
          c.transactions.forEach((t) => {
            if (t.status === 'Paid') paid += t.amount;
            else due += t.amount;
          });
          c.monthlyHistory.forEach((mh, idx) => {
            if (mergedHistory[idx]) {
              mergedHistory[idx].collected += mh.collected;
              mergedHistory[idx].pending += mh.pending;
            }
          });
        });

        return { paid, due, monthlyHistory: mergedHistory };
      }, [clients]);

      const invoiceTotal = useMemo(
        () => invoiceForm.items.reduce((sum, it) => sum + (parseFloat(it.qty) || 0) * (parseFloat(it.rate) || 0), 0),
        [invoiceForm.items]
      );

      const handleAddClient = (e) => {
        e.preventDefault();
        if (!newClientForm.name.trim()) return;
        const quoteAmt = parseFloat(newClientForm.quote) || 0;
        const newId = `cli-${Date.now()}`;

        const created = {
          id: newId,
          name: newClientForm.name.trim(),
          company: newClientForm.name.trim(),
          service: newClientForm.service.trim() || 'Client Service',
          email: newClientForm.email.trim() || 'client@email.com',
          phone: newClientForm.phone.trim() || '(403) 555-0100',
          status: 'Active',
          monthlyHistory: [
            { month: 'Jun', collected: 0, pending: 0 },
            { month: 'Jul', collected: 0, pending: 0 },
            { month: 'Aug', collected: 0, pending: 0 },
            { month: 'Sep', collected: 0, pending: 0 },
            { month: 'Oct', collected: 0, pending: 0 },
            { month: 'Nov', collected: 0, pending: quoteAmt }
          ],
          transactions:
            quoteAmt > 0
              ? [
                  {
                    id: `INV-${Math.floor(1000 + Math.random() * 9000)}`,
                    date: new Date().toISOString().split('T')[0],
                    dueDate: new Date(Date.now() + 7 * 86400000).toISOString().split('T')[0],
                    description: `${newClientForm.service.trim() || 'Initial Project'} Quote`,
                    items: [{ desc: newClientForm.service.trim() || 'Initial Service Package', qty: 1, rate: quoteAmt }],
                    amount: quoteAmt,
                    status: 'Pending'
                  }
                ]
              : [],
          plans: [],
          messages: []
        };

        setClients((prev) => [created, ...prev]);
        setSelectedClientId(newId);
        setViewMode('client');
        setShowAddClientModal(false);
        setNewClientForm({ name: '', email: '', phone: '', service: '', quote: '1200' });
        showToast(`Added ${created.name}`);
      };

      const handleTestBookingSubmission = (e) => {
        e.preventDefault();
        if (!testLeadForm.name.trim()) return;
        const quoteAmt = parseFloat(testLeadForm.quote) || 1250;
        const newId = `cli-${Date.now()}`;

        const bookedClient = {
          id: newId,
          name: testLeadForm.name.trim(),
          company: testLeadForm.name.trim(),
          service: testLeadForm.service.trim() || 'Booked Session',
          email: testLeadForm.email.trim() || 'lead@client.ca',
          phone: '(403) 555-0199',
          status: 'Booked',
          monthlyHistory: [
            { month: 'Jun', collected: 0, pending: 0 },
            { month: 'Jul', collected: 0, pending: 0 },
            { month: 'Aug', collected: 0, pending: 0 },
            { month: 'Sep', collected: 0, pending: 0 },
            { month: 'Oct', collected: 0, pending: 0 },
            { month: 'Nov', collected: 0, pending: quoteAmt }
          ],
          transactions: [
            {
              id: `INV-${Math.floor(1000 + Math.random() * 9000)}`,
              date: new Date().toISOString().split('T')[0],
              dueDate: testLeadForm.date,
              description: `${testLeadForm.service} (Booking Link Intake)`,
              items: [{ desc: testLeadForm.service, qty: 1, rate: quoteAmt }],
              amount: quoteAmt,
              status: 'Pending'
            }
          ],
          plans: [
            {
              id: `PLN-${Date.now()}`,
              title: `${testLeadForm.service} — Confirmed Session`,
              date: testLeadForm.date,
              time: '1:00 PM',
              location: 'Booked via Public Link',
              completed: false
            }
          ],
          messages: []
        };

        setClients((prev) => [bookedClient, ...prev]);
        setSelectedClientId(newId);
        setViewMode('client');
        setShowConnectModal(false);
        setTestLeadForm({
          name: '',
          email: '',
          service: 'Full Agency Package',
          date: new Date(Date.now() + 5 * 86400000).toISOString().split('T')[0],
          quote: '1250'
        });
        showToast(`New booking received from ${bookedClient.name}`);
      };

      const handleRemoveClient = (clientId) => {
        const remaining = clients.filter((c) => c.id !== clientId);
        setClients(remaining);
        setConfirmDeleteId(null);
        if (remaining.length > 0) setSelectedClientId(remaining[0].id);
        else setViewMode('global');
        showToast('Client removed');
      };

      const handleCreateInvoice = (e) => {
        e.preventDefault();
        if (!activeClient || invoiceTotal <= 0) return;
        const isPaid = invoiceForm.status === 'Paid';

        const newTx = {
          id: `INV-${Math.floor(1000 + Math.random() * 9000)}`,
          date: new Date().toISOString().split('T')[0],
          dueDate: invoiceForm.dueDate,
          description: invoiceForm.description.trim() || invoiceForm.items[0]?.desc || 'Client Service Invoice',
          items: invoiceForm.items.map((it) => ({
            desc: it.desc || 'Service Item',
            qty: parseFloat(it.qty) || 1,
            rate: parseFloat(it.rate) || 0
          })),
          amount: Number(invoiceTotal.toFixed(2)),
          status: invoiceForm.status
        };

        setClients((prev) =>
          prev.map((c) => {
            if (c.id !== activeClient.id) return c;
            const updatedHistory = c.monthlyHistory.map((m, i) =>
              i === c.monthlyHistory.length - 1
                ? {
                    ...m,
                    collected: m.collected + (isPaid ? newTx.amount : 0),
                    pending: m.pending + (!isPaid ? newTx.amount : 0)
                  }
                : m
            );
            return { ...c, transactions: [newTx, ...c.transactions], monthlyHistory: updatedHistory };
          })
        );

        setShowInvoiceModal(false);
        showToast(isPaid ? `Recorded ${formatCurrency(newTx.amount)} payment` : `Created ${newTx.id}`);
      };

      const handleMarkPaid = (txId) => {
        if (!activeClient) return;
        setClients((prev) =>
          prev.map((c) => {
            if (c.id !== activeClient.id) return c;
            const target = c.transactions.find((t) => t.id === txId);
            if (!target || target.status === 'Paid') return c;
            const updatedHistory = c.monthlyHistory.map((m, i) =>
              i === c.monthlyHistory.length - 1
                ? {
                    ...m,
                    collected: m.collected + target.amount,
                    pending: Math.max(0, m.pending - target.amount)
                  }
                : m
            );
            return {
              ...c,
              transactions: c.transactions.map((t) => (t.id === txId ? { ...t, status: 'Paid' } : t)),
              monthlyHistory: updatedHistory
            };
          })
        );
        showToast('Invoice marked Paid');
      };

      const handleProcessDigitalTransaction = (e) => {
        e.preventDefault();
        if (!activeClient || processingDigitalTx) return;
        const amt = parseFloat(digitalTxForm.amount);
        if (!Number.isFinite(amt) || amt <= 0) {
          showToast('Enter a valid amount greater than $0');
          return;
        }
        setProcessingDigitalTx(true);

        setTimeout(() => {
          const txId = `TXN-${Math.floor(100000 + Math.random() * 900000)}`;
          const todayStr = new Date().toISOString().split('T')[0];
          const refCode =
            digitalTxForm.reference.trim() ||
            `${digitalTxForm.method.split(' ')[0].toUpperCase()}-${Date.now().toString().slice(-4)}`;
          const label = digitalTxForm.note.trim() || `Digital ${digitalTxForm.method} Payment — ${activeClient.name}`;

          const completedTx = {
            id: txId,
            date: todayStr,
            dueDate: todayStr,
            description: `${label} (${refCode})`,
            items: [{ desc: `${digitalTxForm.method} · Ref ${refCode}`, qty: 1, rate: Number(amt.toFixed(2)) }],
            amount: Number(amt.toFixed(2)),
            status: 'Paid'
          };

          setClients((prev) =>
            prev.map((c) => {
              if (c.id !== activeClient.id) return c;
              const updatedHistory = c.monthlyHistory.map((m, i) =>
                i === c.monthlyHistory.length - 1 ? { ...m, collected: m.collected + completedTx.amount } : m
              );
              return { ...c, transactions: [completedTx, ...c.transactions], monthlyHistory: updatedHistory };
            })
          );

          setProcessingDigitalTx(false);
          setShowDigitalPayModal(false);
          setDigitalTxForm({ amount: '500', method: 'Card / Stripe', reference: '', note: '' });
          showToast(`Processed ${formatCurrency(completedTx.amount)} via ${digitalTxForm.method}`);
        }, 300);
      };

      const handleSendClientText = (e) => {
        e.preventDefault();
        if (!activeClient) return;
        const body = smsInput.trim();
        if (!body) return;

        const timeLabel = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        const outgoingMsg = { id: `MSG-${Date.now()}`, sender: 'agency', text: body, time: timeLabel };

        setClients((prev) =>
          prev.map((c) => (c.id === activeClient.id ? { ...c, messages: [...(c.messages || []), outgoingMsg] } : c))
        );
        setSmsInput('');
        showToast(`Text sent to ${activeClient.name}`);
      };

      const handleAddPlan = (e) => {
        e.preventDefault();
        const targetClientId = planForm.clientId || activeClient?.id;
        if (!targetClientId || !planForm.title.trim()) return;
        const newPlan = {
          id: `PLN-${Date.now()}`,
          title: planForm.title.trim(),
          date: planForm.date,
          time: planForm.time.trim() || '10:00 AM',
          location: planForm.location.trim() || 'On-Location / Remote',
          completed: false
        };
        setClients((prev) =>
          prev.map((c) => (c.id === targetClientId ? { ...c, plans: [newPlan, ...c.plans] } : c))
        );
        setShowPlanModal(false);
        setPlanForm({
          clientId: targetClientId,
          title: '',
          date: new Date().toISOString().split('T')[0],
          time: '10:00 AM',
          location: ''
        });
        showToast('Session added to schedule');
      };

      const togglePlanCompleted = (clientId, planId) => {
        setClients((prev) =>
          prev.map((c) =>
            c.id === clientId
              ? { ...c, plans: c.plans.map((p) => (p.id === planId ? { ...p, completed: !p.completed } : p)) }
              : c
          )
        );
      };

      const handleDeletePlan = (clientId, planId) => {
        setClients((prev) =>
          prev.map((c) => (c.id === clientId ? { ...c, plans: c.plans.filter((p) => p.id !== planId) } : c))
        );
        showToast('Session removed from schedule');
      };

      const totalScheduledCount = useMemo(
        () => clients.reduce((sum, c) => sum + (c.plans ? c.plans.length : 0), 0),
        [clients]
      );

      const handleQuickAddPlanFromAi = (title, dateStr = '2026-11-28', timeStr = '2:00 PM', locStr = 'Calgary / Remote') => {
        if (!activeClient) return;
        const newPlan = { id: `PLN-${Date.now()}`, title, date: dateStr, time: timeStr, location: locStr, completed: false };
        setClients((prev) =>
          prev.map((c) => (c.id === activeClient.id ? { ...c, plans: [newPlan, ...c.plans] } : c))
        );
        setActiveTab('schedule');
        showToast(`Added "${title}" to ${activeClient.name}'s schedule`);
      };

      const buildSmartAiResponse = (queryText) => {
        const q = queryText.toLowerCase();
        if (!activeClient) {
          return {
            text:
              `Portfolio Snapshot (${clients.length} clients):\n` +
              `• Collected: ${formatCurrency(globalFinancials.paid)}\n` +
              `• Balance Due: ${formatCurrency(globalFinancials.due)}`,
            suggestedPlan: null
          };
        }
        const firstName = activeClient.name.split(' ')[0];
        const unpaidTx = activeClient.transactions.filter((t) => t.status !== 'Paid');

        if (q.includes('remind') || q.includes('pay') || q.includes('invoice') || q.includes('due')) {
          if (clientFinancials.due <= 0) {
            return {
              text: `${activeClient.name} has $0.00 due right now (${formatCurrency(clientFinancials.paid)} collected total).`,
              suggestedPlan: null
            };
          }
          const invoiceRefs = unpaidTx.map((t) => `${t.id} (${formatCurrency(t.amount)})`).join(', ');
          return {
            text:
              `Open Balance for ${activeClient.name}: ${formatCurrency(clientFinancials.due)}\n` +
              `Draft Message:\n"Hi ${firstName}, quick heads-up that ${formatCurrency(clientFinancials.due)} is currently open for ${activeClient.service} (${invoiceRefs}). Let me know if you need anything!"`,
            suggestedPlan: null
          };
        }

        if (q.includes('session') || q.includes('schedule') || q.includes('plan') || q.includes('propose')) {
          const proposedTitle = `${activeClient.service} Follow-Up & Review`;
          return {
            text: `Proposed Next Session for ${activeClient.name}:\n• "${proposedTitle}" on 2026-11-28 at 2:00 PM`,
            suggestedPlan: {
              title: proposedTitle,
              date: '2026-11-28',
              time: '2:00 PM',
              location: activeClient.plans[0]?.location || 'Calgary / Google Meet'
            }
          };
        }

        return {
          text:
            `${activeClient.name} (${activeClient.service})\n` +
            `• Paid: ${formatCurrency(clientFinancials.paid)}\n` +
            `• Balance Due: ${formatCurrency(clientFinancials.due)}\n` +
            `• Next Session: ${clientFinancials.nextSession}`,
          suggestedPlan: null
        };
      };

      const sendAiPrompt = async (preset) => {
        const query = (preset || aiInput).trim();
        if (!query || aiLoading) return;

        const cid = activeClient ? activeClient.id : 'global';
        const prevMsgs = aiHistories[cid] || [];
        const nextMsgs = [...prevMsgs, { role: 'user', text: query }];

        setAiHistories((prev) => ({ ...prev, [cid]: nextMsgs }));
        if (!preset) setAiInput('');
        setAiLoading(true);

        const smartResult = buildSmartAiResponse(query);

        if (!aiApiKey.trim()) {
          setTimeout(() => {
            setAiHistories((prev) => ({
              ...prev,
              [cid]: [...nextMsgs, { role: 'assistant', text: smartResult.text, suggestedPlan: smartResult.suggestedPlan }]
            }));
            setAiLoading(false);
          }, 250);
          return;
        }

        try {
          const res = await fetch(
            `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${encodeURIComponent(aiApiKey.trim())}`,
            {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                contents: nextMsgs.map((m) => ({ role: m.role === 'user' ? 'user' : 'model', parts: [{ text: m.text }] }))
              })
            }
          );
          if (!res.ok) throw new Error('API error');
          const data = await res.json();
          const reply = data?.candidates?.[0]?.content?.parts?.[0]?.text || smartResult.text;
          setAiHistories((prev) => ({
            ...prev,
            [cid]: [...nextMsgs, { role: 'assistant', text: reply, suggestedPlan: smartResult.suggestedPlan }]
          }));
        } catch {
          setAiHistories((prev) => ({
            ...prev,
            [cid]: [...nextMsgs, { role: 'assistant', text: smartResult.text, suggestedPlan: smartResult.suggestedPlan }]
          }));
        } finally {
          setAiLoading(false);
        }
      };

      const theme = {
        bg: darkMode ? 'bg-[#09090B] text-[#FAFAFA]' : 'bg-[#FFFFFF] text-[#09090B]',
        surface: darkMode ? 'bg-[#111114]' : 'bg-[#FAFAFA]',
        card: darkMode ? 'bg-[#111114] border-[#27272A]' : 'bg-[#FFFFFF] border-[#E4E4E7]',
        border: darkMode ? 'border-[#27272A]' : 'border-[#E4E4E7]',
        mutedText: darkMode ? 'text-[#A1A1AA]' : 'text-[#71717A]',
        subtleBg: darkMode ? 'bg-[#18181B]' : 'bg-[#F4F4F5]',
        hoverBg: darkMode ? 'hover:bg-[#18181B]' : 'hover:bg-[#F4F4F5]',
        primaryBtn: darkMode ? 'bg-[#FAFAFA] text-[#09090B] hover:bg-[#E4E4E7]' : 'bg-[#09090B] text-[#FFFFFF] hover:bg-[#27272A]',
        secondaryBtn: darkMode ? 'bg-[#111114] text-[#FAFAFA] border border-[#27272A] hover:bg-[#18181B]' : 'bg-[#FFFFFF] text-[#09090B] border border-[#E4E4E7] hover:bg-[#FAFAFA]',
        input: darkMode ? 'bg-[#09090B] border-[#27272A] text-[#FAFAFA] placeholder-[#71717A] focus:border-[#FAFAFA]' : 'bg-[#FFFFFF] border-[#E4E4E7] text-[#09090B] placeholder-[#A1A1AA] focus:border-[#09090B]'
      };

      const currentChatKey = activeClient ? activeClient.id : 'global';
      const currentAiMessages = aiHistories[currentChatKey] || [];

      return (
        <div className={`min-h-screen flex flex-col transition-colors duration-200 antialiased ${theme.bg}`}>
