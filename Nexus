  // Create itemized invoice
  const handleCreateInvoice = (e) => {
    e.preventDefault();
    if (!activeClient || invoiceTotal <= 0) return;
    const isPaid = invoiceForm.status === 'Paid';

    const newTx = {
      id: `INV-${Math.floor(1000 + Math.random() * 9000)}`,
      date: invoiceForm.date || new Date().toISOString().split('T')[0],
      dueDate: invoiceForm.dueDate,
      description:
        invoiceForm.description.trim() || invoiceForm.items[0]?.desc || 'Client Service Invoice',
      items: invoiceForm.items.map((it) => ({
        desc: it.desc || 'Service Item',
        qty: parseFloat(it.qty) || 1,
        rate: parseFloat(it.rate) || 0
      })),
      amount: Number(invoiceTotal.toFixed(2)),
      status: invoiceForm.status
    };

    setClients((prev) =>
      prev.map((c) => {
        if (c.id !== activeClient.id) return c;
        const updatedHistory = c.monthlyHistory.map((m, i) =>
          i === c.monthlyHistory.length - 1
            ? {
                ...m,
                collected: m.collected + (isPaid ? newTx.amount : 0),
                pending: m.pending + (!isPaid ? newTx.amount : 0)
              }
            : m
        );
        return {
          ...c,
          transactions: [newTx, ...c.transactions],
          monthlyHistory: updatedHistory
        };
      })
    );

    setShowInvoiceModal(false);
    showToast(isPaid ? `Recorded ${formatCurrency(newTx.amount)} payment` : `Created ${newTx.id}`);
  };

  // Mark invoice paid in one click
  const handleMarkPaid = (txId) => {
    if (!activeClient) return;
    setClients((prev) =>
      prev.map((c) => {
        if (c.id !== activeClient.id) return c;
        const target = c.transactions.find((t) => t.id === txId);
        if (!target || target.status === 'Paid') return c;
        const updatedHistory = c.monthlyHistory.map((m, i) =>
          i === c.monthlyHistory.length - 1
            ? {
                ...m,
                collected: m.collected + target.amount,
                pending: Math.max(0, m.pending - target.amount)
              }
            : m
        );
        return {
          ...c,
          transactions: c.transactions.map((t) =>
            t.id === txId ? { ...t, status: 'Paid' } : t
          ),
          monthlyHistory: updatedHistory
        };
      })
    );
    showToast('Invoice marked Paid');
  };

  // Schedule new date/milestone
  const handleAddPlan = (e) => {
    e.preventDefault();
    if (!activeClient || !planForm.title.trim()) return;
    const newPlan = {
      id: `PLN-${Date.now()}`,
      title: planForm.title.trim(),
      date: planForm.date,
      time: planForm.time.trim() || '10:00 AM',
      location: planForm.location.trim() || 'On-Location / Remote',
      completed: false
    };
    setClients((prev) =>
      prev.map((c) => (c.id === activeClient.id ? { ...c, plans: [newPlan, ...c.plans] } : c))
    );
    setShowPlanModal(false);
    setPlanForm({
      title: '',
      date: new Date().toISOString().split('T')[0],
      time: '10:00 AM',
      location: ''
    });
    showToast('Added to schedule');
  };

  const togglePlanCompleted = (planId) => {
    if (!activeClient) return;
    setClients((prev) =>
      prev.map((c) =>
        c.id === activeClient.id
          ? {
              ...c,
              plans: c.plans.map((p) => (p.id === planId ? { ...p, completed: !p.completed } : p))
            }
          : c
      )
    );
  };

  const handleQuickAddPlanFromAi = (
    title,
    dateStr = '2026-11-28',
    timeStr = '2:00 PM',
    locStr = 'Calgary / Remote'
  ) => {
    if (!activeClient) return;
    const newPlan = {
      id: `PLN-${Date.now()}`,
      title,
      date: dateStr,
      time: timeStr,
      location: locStr,
      completed: false
    };
    setClients((prev) =>
      prev.map((c) => (c.id === activeClient.id ? { ...c, plans: [newPlan, ...c.plans] } : c))
    );
    setActiveTab('schedule');
    showToast(`Added "${title}" to ${activeClient.name}'s schedule`);
  };

  const buildSmartAiResponse = (queryText) => {
    const q = queryText.toLowerCase();

    if (!activeClient) {
      const topDueClient = [...clients]
        .map((c) => ({
          name: c.name,
          due: c.transactions.filter((t) => t.status !== 'Paid').reduce((s, t) => s + t.amount, 0)
        }))
        .sort((a, b) => b.due - a.due)[0];

      return {
        text:
          `Portfolio Snapshot (${clients.length} clients):\n` +
          `• Collected: ${formatCurrency(globalFinancials.paid)}\n` +
          `• Balance Due: ${formatCurrency(globalFinancials.due)}\n` +
          (topDueClient && topDueClient.due > 0
            ? `• Largest Open Balance: ${topDueClient.name} (${formatCurrency(topDueClient.due)})\n\n` +
              `Next Move: Select ${topDueClient.name} on the left to send a payment reminder or review open invoices.`
            : `• All balances are clear—great time to reach out and book upcoming retainers.`),
        suggestedPlan: null
      };
    }

    const firstName = activeClient.name.split(' ')[0];
    const unpaidTx = activeClient.transactions.filter((t) => t.status !== 'Paid');
    const overdueTx = activeClient.transactions.filter((t) => t.status === 'Overdue');
    const upcomingPlans = activeClient.plans.filter((p) => !p.completed);

    if (
      q.includes('remind') ||
      q.includes('pay') ||
      q.includes('invoice') ||
      q.includes('due') ||
      q.includes('overdue')
    ) {
      if (clientFinancials.due <= 0) {
        return {
          text:
            `${activeClient.name} has ${formatCurrency(0)} due right now (${formatCurrency(
              clientFinancials.paid
            )} collected total).\n\n` +
            `Suggested Follow-Up:\n"Hey ${firstName}, thanks again for working together on ${activeClient.service}. Let me know when you're ready for the next batch or session!"`,
          suggestedPlan: null
        };
      }

      const invoiceRefs = unpaidTx.map((t) => `${t.id} (${formatCurrency(t.amount)})`).join(', ');
      const toneNote = overdueTx.length > 0 ? ' (includes overdue balance)' : '';

      return {
        text:
          `Open Balance for ${activeClient.name}: ${formatCurrency(clientFinancials.due)}${toneNote}\n` +
          `Invoices: ${invoiceRefs}\n\n` +
          `Draft Message:\n"Hi ${firstName}, quick heads-up that ${formatCurrency(
            clientFinancials.due
          )} is currently open for ${activeClient.service} (${invoiceRefs}). Let me know if you have any questions or need a fresh copy of the receipt!"`,
        suggestedPlan: null
      };
    }

    if (
      q.includes('session') ||
      q.includes('schedule') ||
      q.includes('plan') ||
      q.includes('date') ||
      q.includes('book') ||
      q.includes('propose')
    ) {
      const proposedTitle = `${activeClient.service} Follow-Up & Review`;
      return {
        text:
          `${activeClient.name} Schedule Status:\n` +
          (upcomingPlans.length > 0
            ? upcomingPlans
                .map((p) => `• ${p.date} at ${p.time} — ${p.title} (${p.location})`)
                .join('\n')
            : '• No upcoming sessions currently on the calendar.') +
          `\n\nProposed Next Session:\n• "${proposedTitle}" on 2026-11-28 at 2:00 PM`,
        suggestedPlan: {
          title: proposedTitle,
          date: '2026-11-28',
          time: '2:00 PM',
          location: activeClient.plans[0]?.location || 'Calgary / Google Meet'
        }
      };
    }

    return {
      text:
        `${activeClient.name} (${activeClient.company}) — ${activeClient.service}\n` +
        `• Paid: ${formatCurrency(clientFinancials.paid)}\n` +
        `• Balance Due: ${formatCurrency(clientFinancials.due)} (${unpaidTx.length} open)\n` +
        `• Next Session: ${clientFinancials.nextSession}\n\n` +
        `Recommended Action:\n` +
        (clientFinancials.due > 0
          ? `Send a friendly reminder on ${unpaidTx[0]?.id || 'open invoice'} and confirm ${
              clientFinancials.nextSession
            }.`
          : `Confirm next deliverable milestone for ${activeClient.service}.`),
      suggestedPlan: null
    };
  };

  const sendAiPrompt = async (preset) => {
    const query = (preset || aiInput).trim();
    if (!query || aiLoading) return;

    const cid = activeClient ? activeClient.id : 'global';
    const prevMsgs = aiHistories[cid] || [];
    const nextMsgs = [...prevMsgs, { role: 'user', text: query }];

    setAiHistories((prev) => ({ ...prev, [cid]: nextMsgs }));
    if (!preset) setAiInput('');
    setAiLoading(true);

    const contextSummary = activeClient
      ? `Client: ${activeClient.name} (${activeClient.company}, ${activeClient.service}) | Email: ${activeClient.email} | Total Paid: ${formatCurrency(
          clientFinancials.paid
        )} | Balance Due: ${formatCurrency(clientFinancials.due)} | Invoices: ${
          activeClient.transactions
            .map((t) => `${t.id}:${t.status}:${formatCurrency(t.amount)}`)
            .join(', ') || 'None'
        } | Upcoming Schedule: ${
          activeClient.plans
            .filter((p) => !p.completed)
            .map((p) => `${p.date} ${p.time} (${p.title})`)
            .join('; ') || 'None'
        }`
      : `Global Business Overview: ${clients.length} total clients | Total Collected: ${formatCurrency(
          globalFinancials.paid
        )} | Total Due: ${formatCurrency(globalFinancials.due)}`;

    const systemPrompt = `You are Nexus AI Copilot inside a minimalist Client Portal & CRM. Keep answers concise, sharp, and immediately usable for client communication, billing, and scheduling. Current workspace context: ${contextSummary}`;

    const smartResult = buildSmartAiResponse(query);

    if (!aiApiKey.trim()) {
      setTimeout(() => {
        setAiHistories((prev) => ({
          ...prev,
          [cid]: [
            ...nextMsgs,
            {
              role: 'assistant',
              text: smartResult.text,
              suggestedPlan: smartResult.suggestedPlan
            }
          ]
        }));
        setAiLoading(false);
      }, 250);
      return;
    }

    const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${encodeURIComponent(
      aiApiKey.trim()
    )}`;

    const payload = {
      contents: nextMsgs.map((m) => ({
        role: m.role === 'user' ? 'user' : 'model',
        parts: [{ text: m.text }]
      })),
      systemInstruction: { parts: [{ text: systemPrompt }] }
    };

    try {
      const res = await fetch(apiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      if (!res.ok) throw new Error('API request failed');
      const data = await res.json();
      const reply = data?.candidates?.[0]?.content?.parts?.[0]?.text || smartResult.text;
      setAiHistories((prev) => ({
        ...prev,
        [cid]: [
          ...nextMsgs,
          {
            role: 'assistant',
            text: reply,
            suggestedPlan: smartResult.suggestedPlan
          }
        ]
      }));
    } catch {
      setAiHistories((prev) => ({
        ...prev,
        [cid]: [
          ...nextMsgs,
          {
            role: 'assistant',
            text: `${smartResult.text}\n\n(Using local workspace assistant — check your Gemini API key in AI settings for live cloud responses.)`,
            suggestedPlan: smartResult.suggestedPlan
