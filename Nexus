  // Supabase connection settings (from Vite env or saved in browser)
  const [supabaseConfig, setSupabaseConfig] = useState(() => {
    try {
      const envUrl =
        typeof import.meta !== 'undefined' && import.meta.env
          ? import.meta.env.VITE_SUPABASE_URL || ''
          : '';
      const envKey =
        typeof import.meta !== 'undefined' && import.meta.env
          ? import.meta.env.VITE_SUPABASE_ANON_KEY || import.meta.env.VITE_SUPABASE_PUBLISHABLE_KEY || ''
          : '';
      const saved = JSON.parse(window.localStorage?.getItem('nexus_supabase_config') || '{}');
      return {
        url: envUrl || saved.url || '',
        anonKey: envKey || saved.anonKey || ''
      };
    } catch {
      return { url: '', anonKey: '' };
    }
  });
  const [supabaseStatus, setSupabaseStatus] = useState('local'); // 'local' | 'syncing' | 'connected' | 'error'
  const hasHydratedSupabaseRef = useRef(false);

  // Core navigation & client data (persisted to localStorage + Supabase when configured)
