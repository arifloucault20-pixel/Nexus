    // 3-Mode Interactive Financial Chart: Stacked Bars, Cash Flow Trend, Collection Split Donut
    function RevenueChart({ data, darkMode }) {
      const [chartType, setChartType] = useState('bar');
      const [hoveredIdx, setHoveredIdx] = useState(null);
      const [selectedIdx, setSelectedIdx] = useState(null);

      const maxVal = useMemo(() => {
        const peak = Math.max(...data.map((d) => d.collected + d.pending), 1000);
        return Math.ceil(peak / 500) * 500;
      }, [data]);

      const totals = useMemo(() => {
        const collected = data.reduce((s, d) => s + (d.collected || 0), 0);
        const pending = data.reduce((s, d) => s + (d.pending || 0), 0);
        const grand = collected + pending;
        const paidPct = grand > 0 ? Math.round((collected / grand) * 100) : 0;
        const avgMonthly = data.length > 0 ? grand / data.length : 0;

        const last = data[data.length - 1];
        const prev = data[data.length - 2];
        const lastTotal = last ? (last.collected || 0) + (last.pending || 0) : 0;
        const prevTotal = prev ? (prev.collected || 0) + (prev.pending || 0) : 0;
        const momGrowth =
          prevTotal > 0 ? Math.round(((lastTotal - prevTotal) / prevTotal) * 100) : lastTotal > 0 ? 100 : 0;

        return { collected, pending, grand, paidPct, avgMonthly, momGrowth };
      }, [data]);

      const activeIdx = hoveredIdx !== null ? hoveredIdx : selectedIdx;
      const activePoint = activeIdx !== null && data[activeIdx] ? data[activeIdx] : null;

      const trendGeometry = useMemo(() => {
        const startX = 68;
        const endX = 576;
        const stepX = data.length > 1 ? (endX - startX) / (data.length - 1) : 0;

        const points = data.map((d, i) => {
          const x = startX + i * stepX;
          const totalAmt = (d.collected || 0) + (d.pending || 0);
          const yCollected = 142 - ((d.collected || 0) / maxVal) * 118;
          const yTotal = 142 - (totalAmt / maxVal) * 118;
          return { ...d, x, yCollected, yTotal, totalAmt };
        });

        const buildSmoothPath = (pts, yKey) => {
          if (pts.length === 0) return '';
          if (pts.length === 1) return `M ${pts[0].x.toFixed(1)} ${pts[0][yKey].toFixed(1)}`;
          let path = `M ${pts[0].x.toFixed(1)} ${pts[0][yKey].toFixed(1)}`;
          for (let i = 0; i < pts.length - 1; i++) {
            const p0 = pts[i];
            const p1 = pts[i + 1];
            const midX = ((p0.x + p1.x) / 2).toFixed(1);
            path += ` C ${midX} ${p0[yKey].toFixed(1)}, ${midX} ${p1[yKey].toFixed(1)}, ${p1.x.toFixed(1)} ${p1[yKey].toFixed(1)}`;
          }
          return path;
        };

        const collectedLine = buildSmoothPath(points, 'yCollected');
        const totalLine = buildSmoothPath(points, 'yTotal');
        const areaPath =
          points.length > 0
            ? `${collectedLine} L ${points[points.length - 1].x.toFixed(1)} 142 L ${points[0].x.toFixed(1)} 142 Z`
            : '';

        return { points, collectedLine, totalLine, areaPath };
      }, [data, maxVal]);

      const donutCircumference = 2 * Math.PI * 52;
      const collectedArc = (totals.paidPct / 100) * donutCircumference;

      return (
        <div className="relative pt-2 space-y-4">
          <div
            className={`grid grid-cols-3 gap-2.5 p-3 rounded-2xl border text-xs ${
              darkMode ? 'bg-[#18181B]/70 border-[#27272A]' : 'bg-[#FAFAFA] border-[#E4E4E7]'
            }`}
          >
            <div>
              <span className={`text-[10px] uppercase tracking-wider font-semibold block ${darkMode ? 'text-[#A1A1AA]' : 'text-[#71717A]'}`}>
                6-Mo Volume
              </span>
              <span className="text-sm font-bold tabular-nums">{formatCurrency(totals.grand)}</span>
            </div>
            <div>
              <span className={`text-[10px] uppercase tracking-wider font-semibold block ${darkMode ? 'text-[#A1A1AA]' : 'text-[#71717A]'}`}>
                Monthly Avg
              </span>
              <span className="text-sm font-bold tabular-nums">{formatCurrency(totals.avgMonthly)}</span>
            </div>
            <div className="text-right">
              <span className={`text-[10px] uppercase tracking-wider font-semibold block ${darkMode ? 'text-[#A1A1AA]' : 'text-[#71717A]'}`}>
                MoM Pace
              </span>
              <span className={`text-sm font-bold tabular-nums ${totals.momGrowth >= 0 ? 'text-emerald-500' : 'text-amber-500'}`}>
                {totals.momGrowth >= 0 ? `+${totals.momGrowth}%` : `${totals.momGrowth}%`}
              </span>
            </div>
          </div>

          <div className="flex flex-wrap items-center justify-between gap-3">
            <div className="flex items-center gap-4 text-[11px]">
              <span className="flex items-center gap-1.5 font-semibold">
                <span className={`w-2.5 h-2.5 rounded-sm ${darkMode ? 'bg-[#FAFAFA]' : 'bg-[#09090B]'}`} />
                Collected ({totals.paidPct}%)
              </span>
              <span className="flex items-center gap-1.5 font-medium opacity-75">
                <span className="w-2.5 h-2.5 rounded-sm bg-amber-400" />
                Pending
              </span>
            </div>

            <div className="flex items-center gap-2">
              {activePoint && chartType !== 'split' && (
