                  <div className="grid grid-cols-2 gap-3">
                    <input type="date" required value={planForm.date} onChange={(e) => setPlanForm({ ...planForm, date: e.target.value })} className={`w-full px-3.5 py-2 rounded-xl border outline-none ${theme.input}`} />
                    <input type="text" value={planForm.time} onChange={(e) => setPlanForm({ ...planForm, time: e.target.value })} className={`w-full px-3.5 py-2 rounded-xl border outline-none ${theme.input}`} />
                  </div>
                  <input type="text" value={planForm.location} onChange={(e) => setPlanForm({ ...planForm, location: e.target.value })} placeholder="Address or Google Meet link" className={`w-full px-3.5 py-2 rounded-xl border outline-none ${theme.input}`} />
                  <div className="flex justify-end gap-2 pt-3">
                    <button type="button" onClick={() => setShowPlanModal(false)} className={`px-4 py-2 rounded-full font-semibold cursor-pointer ${theme.secondaryBtn}`}>Cancel</button>
                    <button type="submit" className={`px-5 py-2 rounded-full font-semibold cursor-pointer ${theme.primaryBtn}`}>Save Date</button>
                  </div>
                </form>
              </div>
            </div>
          )}
        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>
